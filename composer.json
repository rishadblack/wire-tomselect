{
    "name": "rishadblack/wire-tomselect",
    "description": "Searchable Livewire dropdowns backed by Tom Select",
    "license": "MIT",
    "authors": [
        {
            "name": "S M Rishad",
            "email": "rishad.black@gmail.com",
            "homepage": "https://smrishad.com"
        }
    ],
    "homepage": "https://github.com/rishadblack/wire-tomselect",
    "keywords": [
        "laravel",
        "livewire",
        "tom-select",
        "select",
        "dropdown",
        "alpine"
    ],
    "require": {
        "php": "^8.3",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.8|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Rishadblack\\WireTomselect\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rishadblack\\WireTomselect\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rishadblack\\WireTomselect\\WireTomselectServiceProvider"
            ]
        }
    }
}
